# Copy to .env and adjust. Everything here has a safe default — a missing
# .env must never break development.
#
# Every variable needs a comment saying what it does; the validator enforces
# it. The person setting a value six months from now is reading this file,
# not the documentation. Modules append their own variables when installed,
# with their descriptions, under a header naming the module.

# Show error detail in the browser (dev only — leave empty in production).
APP_DEBUG=
