{
  "name": "contact-form",
  "version": "1",
  "description": "Contact form with a four-layer spam defence and SMTP delivery.",
  "requires": [],
  "core_min": "1",
  "env": {
    "SMTP_HOST": "",
    "SMTP_PORT": "587",
    "SMTP_USER": "",
    "SMTP_PASS": "",
    "MAIL_TO": "you@example.com",
    "MAIL_FROM": "noreply@example.com",
    "MAIL_FROM_NAME": "Website contact form",
    "FORM_TOKEN_SECRET": ""
  },
  "verify": [
    "php scripts/validate-content.php",
    "curl -sf http://localhost:8080/contact/ | grep -q 'name=\"order_ref\"'",
    "curl -s -o /dev/null -w '%{http_code}' -X POST http://localhost:8080/contact/ -d 'name=bot&email=b@example.com&subject=x&message=y&order_ref=filled'"
  ]
}
